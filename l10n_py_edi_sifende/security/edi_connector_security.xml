<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="edi_connector_company_rule" model="ir.rule">
        <field name="name">Conector EDI: multiempresa</field>
        <field name="model_id" ref="l10n_py_edi_base.model_l10n_py_edi_connector" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="l10n_py_transport_company_rule" model="ir.rule">
        <field name="name">Transporte: multiempresa</field>
        <field name="model_id" ref="l10n_py_edi_base.model_l10n_py_transport" />
        <field
            name="domain_force"
        >['|', ('company_id', 'in', company_ids), '&amp;', ('company_id', '=', False), ('create_uid', '=', user.id)]</field>
    </record>
    <record id="l10n_py_transport_vehicle_company_rule" model="ir.rule">
        <field name="name">Vehículo de transporte: multiempresa</field>
        <field name="model_id" ref="l10n_py_edi_base.model_l10n_py_transport_vehicle" />
        <field
            name="domain_force"
        >['|', ('transport_id.company_id', 'in', company_ids), '&amp;', ('transport_id.company_id', '=', False), ('transport_id.create_uid', '=', user.id)]</field>
    </record>
    <record id="l10n_py_transport_delivery_company_rule" model="ir.rule">
        <field name="name">Entrega de transporte: multiempresa</field>
        <field
            name="model_id"
            ref="l10n_py_edi_base.model_l10n_py_transport_delivery"
        />
        <field
            name="domain_force"
        >['|', ('transport_id.company_id', 'in', company_ids), '&amp;', ('transport_id.company_id', '=', False), ('transport_id.create_uid', '=', user.id)]</field>
    </record>
    <!-- Los logs guardan el JSON fiscal completo: solo el rol contable de la empresa -->
    <record id="l10n_py_edi_log_company_rule" model="ir.rule">
        <field name="name">Log EDI: multiempresa</field>
        <field name="model_id" ref="l10n_py_edi_base.model_l10n_py_edi_log" />
        <field
            name="domain_force"
        >[('company_id', 'in', company_ids + ([False] if user.has_group('base.group_system') else []))]</field>
    </record>
    <record id="l10n_py_edi_log_accounting_rule" model="ir.rule">
        <field name="name">Log EDI: rol contable</field>
        <field name="model_id" ref="l10n_py_edi_base.model_l10n_py_edi_log" />
        <field
            name="domain_force"
        >[(1, '=', 1)] if user.has_group('account.group_account_readonly') or user.has_group('account.group_account_invoice') else [(0, '=', 1)]</field>
    </record>
</odoo>
